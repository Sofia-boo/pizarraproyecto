{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://blank-partition-router-numerical.trycloudflare.com/api/:path*"
    },
    {
      "source": "/recognize/:path*",
      "destination": "https://blank-partition-router-numerical.trycloudflare.com/recognize/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{"key": "Cache-Control", "value": "no-cache"}]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{"key": "Cache-Control", "value": "no-cache"}]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
