{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://government-focuses-rehab-violations.trycloudflare.com/api/:path*"
    },
    {
      "source": "/recognize/:path*",
      "destination": "https://government-focuses-rehab-violations.trycloudflare.com/recognize/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
