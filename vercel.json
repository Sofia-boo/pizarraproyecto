{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "functions": {
    "api/ocr-setup.js": {"includeFiles": "vercel.json", "maxDuration": 30}
  },
  "rewrites": [
    {
      "source": "/integrations/ocr-link",
      "destination": "/api/ocr-setup"
    },
    {
      "source": "/api/:path*",
      "destination": "https://occurs-gen-improvements-laura.trycloudflare.com/api/:path*"
    },
    {
      "source": "/recognize/:path*",
      "destination": "https://occurs-gen-improvements-laura.trycloudflare.com/recognize/:path*"
    }
  ],
  "headers": [
    {
      "source": "/sw.js",
      "headers": [{"key": "Cache-Control", "value": "no-cache"}]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [{"key": "Cache-Control", "value": "no-cache"}]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
